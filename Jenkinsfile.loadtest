// =====================================================================
// 부하테스트 전용 Jenkins 파이프라인 (on-demand, 버튼 실행)
//
// 사용법:
//   Jenkins > New Item > Pipeline 생성 > Pipeline script from SCM
//     - SCM: 이 백엔드 레포
//     - Script Path: Jenkinsfile.loadtest
//   생성 후 "Build with Parameters" 버튼으로 smoke/load/stress 선택 실행.
//
// 결과:
//   - 콘솔에 요약/한계점 표
//   - 빌드 페이지 좌측 "JMeter Report" (HTML Publisher 플러그인 필요)
//   - Artifacts 에 jtl + report 보관
//
// 에이전트 요구사항: curl, tar, python3 (메인 Jenkinsfile 과 동일 환경)
// =====================================================================
pipeline {
    agent any

    parameters {
        choice(name: 'TEST_TYPE', choices: ['smoke', 'load', 'stress'],
               description: 'smoke=게시판 10명 회귀확인 / load=혼합 100명 / stress=단계 상승 한계탐색')
        string(name: 'TARGET_HOST', defaultValue: '163.239.77.78', description: '대상 호스트')
        string(name: 'PORT', defaultValue: '3000', description: '대상 포트 (실서비스 3000)')
        string(name: 'THREADS', defaultValue: '100', description: '[load] 동시 사용자 수')
        string(name: 'DURATION', defaultValue: '60', description: '부하 유지 시간(초). stress는 단계별 시간')
        string(name: 'RAMPUP', defaultValue: '20', description: 'Ramp-up 시간(초)')
        string(name: 'STRESS_STEPS', defaultValue: '10,50,100,200,400', description: '[stress] 동시 사용자 단계(콤마)')
        string(name: 'ENDPOINT_PATH', defaultValue: '/api/board', description: '[stress] 대상 엔드포인트')
        string(name: 'MAX_P95_MS', defaultValue: '1000', description: '[smoke 게이트/stress 한계] p95 임계(ms)')
        string(name: 'MAX_ERROR_RATE', defaultValue: '1', description: '[smoke 게이트/stress 한계] 에러율 임계(%)')
        string(name: 'EMAIL_TO', defaultValue: 'kjyyoung0305@gmail.com, yooncy0511@gmail.com, lee.moonjeong@gmail.com, wq0212@naver.com', description: 'AI 리포트 수신 이메일(쉼표 구분)')
        string(name: 'PROM_URL', defaultValue: 'http://163.239.77.78:9090', description: '서버측 지표 수집용 Prometheus 주소')
    }

    environment {
        JMETER_VERSION = '5.6.3'
        JMETER_HOME = "${WORKSPACE}/apache-jmeter-5.6.3"
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()   // 동시 부하 실행 방지
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Install JMeter') {
            steps {
                sh '''
                    set -e
                    if [ ! -x "$JMETER_HOME/bin/jmeter" ]; then
                        echo "JMeter ${JMETER_VERSION} 다운로드..."
                        curl -fSL "https://archive.apache.org/dist/jmeter/binaries/apache-jmeter-${JMETER_VERSION}.tgz" -o jmeter.tgz
                        tar -xzf jmeter.tgz -C "$WORKSPACE"
                        rm -f jmeter.tgz
                    fi
                    "$JMETER_HOME/bin/jmeter" --version
                '''
            }
        }

        stage('Prepare ids (load)') {
            when { expression { params.TEST_TYPE == 'load' } }
            steps {
                // board 상세(20%)가 유효 id 를 쓰도록 라이브 서버에서 ids.csv 갱신
                sh '''
                    set -e
                    curl -s "http://${TARGET_HOST}:${PORT}/api/board?page=1&size=100" \
                      | python3 -c "import sys,json; print('\\n'.join(str(x['id']) for x in json.load(sys.stdin)))" \
                      > jmeter/ids.csv
                    echo "ids.csv 갱신: $(wc -l < jmeter/ids.csv) 건"
                '''
            }
        }

        stage('Run JMeter') {
            steps {
                sh '''
                    set -e
                    rm -rf results && mkdir -p results
                    JM="$JMETER_HOME/bin/jmeter"

                    case "${TEST_TYPE}" in
                      smoke)
                        $JM -n -t jmeter/board_smoke.jmx \
                          -Jhost=${TARGET_HOST} -Jport=${PORT} \
                          -Jthreads=10 -Jrampup=2 -Jduration=60 -Jthinktime=50 \
                          -l results/result.jtl -j results/jmeter.log -e -o results/report
                        ;;
                      load)
                        $JM -n -t jmeter/load_test.jmx \
                          -Jhost=${TARGET_HOST} -Jport=${PORT} \
                          -Jthreads=${THREADS} -Jrampup=${RAMPUP} -Jduration=${DURATION} -Jthinktime=300 \
                          -l results/result.jtl -j results/jmeter.log -e -o results/report
                        ;;
                      stress)
                        for s in $(echo ${STRESS_STEPS} | tr ',' ' '); do
                          echo "================ STRESS STEP: ${s} users / ${DURATION}s ================"
                          $JM -n -t jmeter/stress_test.jmx \
                            -Jhost=${TARGET_HOST} -Jport=${PORT} \
                            -Jthreads=${s} -Jrampup=${RAMPUP} -Jduration=${DURATION} -Jthinktime=0 -Jpath=${ENDPOINT_PATH} \
                            -l results/stress-${s}.jtl -j results/stress-${s}.log -e -o results/stress-${s}-report
                        done
                        ;;
                    esac
                '''
            }
        }

        stage('Evaluate / Summarize') {
            steps {
                // 1) 클라이언트 결과 요약 + 2) 서버 Prometheus 스냅샷을 파일로 저장 (이메일/AI 입력용)
                sh '''
                    set +e
                    case "${TEST_TYPE}" in
                      stress) python3 jmeter/ci/summarize.py --max-error-rate ${MAX_ERROR_RATE} --max-p95 ${MAX_P95_MS} results/stress-*.jtl | tee results/summary.txt ;;
                      *)      python3 jmeter/ci/summarize.py results/result.jtl | tee results/summary.txt ;;
                    esac
                    python3 jmeter/ci/prom_snapshot.py --prom-url "${PROM_URL}" --window 15m > results/server_snapshot.txt 2>&1 || true
                    echo "----- server snapshot -----"; cat results/server_snapshot.txt
                '''
                // 3) 스모크는 임계 초과 시 빌드 실패(게이트). 위에서 요약/스냅샷 파일은 이미 기록됨.
                script {
                    if (params.TEST_TYPE == 'smoke') {
                        sh 'python3 jmeter/ci/check_smoke.py results/result.jtl --label board --max-error-rate ${MAX_ERROR_RATE} --max-p95 ${MAX_P95_MS}'
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'results/**', allowEmptyArchive: true
            script {
                try {
                    if (params.TEST_TYPE == 'stress') {
                        publishHTML(target: [reportName: "JMeter Report (stress)", reportDir: 'results',
                            reportFiles: 'stress-*-report/index.html', keepAll: true,
                            alwaysLinkToLastBuild: true, allowMissing: true])
                    } else {
                        publishHTML(target: [reportName: "JMeter Report (${params.TEST_TYPE})", reportDir: 'results/report',
                            reportFiles: 'index.html', keepAll: true,
                            alwaysLinkToLastBuild: true, allowMissing: true])
                    }
                } catch (e) {
                    echo "publishHTML 건너뜀 — HTML Publisher 플러그인 설치 시 빌드 페이지에서 리포트 열람 가능. (${e.message})"
                }
            }

            // ── Groq AI 분석 + 이메일 리포트 ──────────────────────────────
            script {
                def summary  = fileExists('results/summary.txt')        ? readFile('results/summary.txt')        : '(요약 없음)'
                def snapshot = fileExists('results/server_snapshot.txt') ? readFile('results/server_snapshot.txt') : '(서버 스냅샷 없음)'
                def meta = "테스트=${params.TEST_TYPE} | 대상=${params.TARGET_HOST}:${params.PORT} | 빌드=#${env.BUILD_NUMBER} | 결과=${currentBuild.currentResult}\n" +
                           "파라미터: threads=${params.THREADS}, duration=${params.DURATION}s, rampup=${params.RAMPUP}, stress_steps=${params.STRESS_STEPS}, endpoint=${params.ENDPOINT_PATH}"

                def context = "[부하테스트 메타]\n${meta}\n\n[클라이언트 결과 (JMeter)]\n${summary}\n\n${snapshot}\n"

                def prompt = "너는 시니어 성능엔지니어이자 SRE다. 아래 부하테스트 결과(클라이언트 JMeter + 서버 Prometheus 스냅샷)를 분석해서 한국어로 보고하라. 반드시 다음 5개 섹션으로 작성:\n" +
                    "1) 종합 판정 (정상/주의/위험 중 하나 + 한 줄 근거)\n" +
                    "2) 핵심 지표 요약 (TPS, p95/p99, 에러율, DB 커넥션 피크/한계)\n" +
                    "3) 병목 진단(근본원인): RPS 정체·지연 급등·DB 커넥션 한계 도달 여부를 근거로 무엇이 병목인지 단정\n" +
                    "4) SLA 평가 (기준: p95 1초 이내, 에러율 1% 미만 충족 여부)\n" +
                    "5) 권장 조치 (구체적·우선순위順. 예: 커넥션 풀(HikariCP 등) 도입, max_connections 조정, 쿼리/인덱스 개선)\n\n" +
                    "[데이터]\n" + context

                writeJSON file: 'groq_loadtest_req.json', json: [
                    model: 'llama-3.3-70b-versatile',
                    messages: [[ role: 'user', content: prompt ]]
                ]

                env.AI_REPORT = 'AI 분석을 가져오지 못했습니다.'
                try {
                    withCredentials([string(credentialsId: 'GROQ_API_KEY', variable: 'GROQ_API_KEY')]) {
                        sh '''
                            curl -sf --max-time 40 --connect-timeout 10 \
                                 -X POST "https://api.groq.com/openai/v1/chat/completions" \
                                 -H "Authorization: Bearer $GROQ_API_KEY" \
                                 -H "Content-Type: application/json" \
                                 -d @groq_loadtest_req.json -o groq_loadtest_resp.json
                        '''
                        def resp = readJSON file: 'groq_loadtest_resp.json'
                        if (resp.choices && resp.choices[0] && resp.choices[0].message) {
                            env.AI_REPORT = resp.choices[0].message.content
                        } else {
                            env.AI_REPORT = "AI 분석 실패(응답 구조 오류): " + sh(script: 'cat groq_loadtest_resp.json', returnStdout: true).trim()
                        }
                    }
                } catch (e) {
                    env.AI_REPORT = "Groq 호출 오류: ${e.message}"
                }

                def esc = { s -> (s ?: '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;') }
                emailext(
                    subject: "📊 [부하테스트] ${params.TEST_TYPE} #${env.BUILD_NUMBER} — ${currentBuild.currentResult}",
                    to: params.EMAIL_TO,
                    mimeType: 'text/html',
                    body: """<div style="font-family:'Malgun Gothic','Apple SD Gothic Neo',sans-serif;">
                                <h2>📊 BoonPick 부하테스트 리포트</h2>
                                <pre style="white-space:pre-wrap;">${esc(meta)}</pre>
                                <h3>🤖 AI 분석 (Groq)</h3>
                                <pre style="background:#f4f4f4;padding:14px;border-radius:6px;white-space:pre-wrap;font-size:14px;">${esc(env.AI_REPORT)}</pre>
                                <h3>📈 원시 결과 (클라이언트 + 서버)</h3>
                                <pre style="background:#fafafa;padding:14px;border-radius:6px;white-space:pre-wrap;font-size:13px;">${esc(summary)}\n${esc(snapshot)}</pre>
                                <p>상세 그래프/아티팩트: <a href="${env.BUILD_URL}">${env.BUILD_URL}</a></p>
                             </div>"""
                )
            }
        }
    }
}
