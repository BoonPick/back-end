# 모니터링/부하테스트용 환경변수 예시. 복사해서 .env 로 쓰세요 (.env 는 git 제외 권장).
#   cp .env.example .env

# ── mysqld-exporter 가 붙을 MySQL 접속 정보 ──────────────────────────
# 호스트에서 직접 MySQL 을 돌리면 host.docker.internal, 원격이면 해당 IP.
DB_HOST=host.docker.internal
DB_PORT=3306
# 모니터링 전용 계정 (아래 SQL 로 생성)
DB_EXPORTER_USER=exporter
DB_EXPORTER_PASSWORD=change-me

# ── JMeter 부하 파라미터 (compose --profile loadtest run jmeter) ────
LT_HOST=host.docker.internal
LT_PORT=8000
LT_THREADS=10
LT_RAMPUP=5
LT_DURATION=30
LT_THINKTIME=200

# =====================================================================
# mysqld-exporter 전용 MySQL 계정 생성 (MySQL 8.x):
#
#   CREATE USER 'exporter'@'%' IDENTIFIED BY 'change-me'
#     WITH MAX_USER_CONNECTIONS 3;
#   GRANT PROCESS, REPLICATION CLIENT, SELECT ON *.* TO 'exporter'@'%';
#   FLUSH PRIVILEGES;
# =====================================================================
